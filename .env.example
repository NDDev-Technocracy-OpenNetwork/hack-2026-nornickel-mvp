# Runtime
APP_ENV=development
APP_BASE_URL=https://nornikel.nddev.asia
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=5173

# Storage
DUCKDB_PATH=data/catalog.duckdb
ARTIFACT_ROOT=data/artifacts
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=evidence_units
MAX_SOURCE_UPLOAD_BYTES=26214400

# LLM (hackathon rules: open-weight models only; OpenAI/Anthropic APIs are forbidden).
# Model IDs are chosen during W0 provider discovery and must have verified open
# weights (exact version on Hugging Face) before being configured.
LLM_ENABLED=false
DATAEYES_API_BASE=https://api.dataeyes.ai/v1
DATAEYES_API_KEY=
LLM_EXTRACTION_MODEL=
LLM_ANSWER_MODEL=
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=1
LLM_MAX_CONCURRENCY=3

# Optional self-hosted fallback (compose profile "fallback")
OLLAMA_BASE_URL=http://ollama:11434

# Embeddings (local by default; API only if discovery finds an open-weight endpoint)
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_ID=deepvk/USER-bge-m3
SPARSE_MODEL_ID=Qdrant/bm25
HF_HOME=/app/data/hf-cache

# Observability (self-hosted Langfuse; SDK v2 callback path)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Security labels
DEFAULT_SOURCE_LABEL=internal
ALLOWED_SOURCE_LABELS=public,internal,confidential,restricted

# Frontend
VITE_API_BASE_URL=/api
