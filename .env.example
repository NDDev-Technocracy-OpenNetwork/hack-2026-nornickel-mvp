# Runtime
APP_ENV=development
APP_BASE_URL=https://fa.nddev.asia
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=5173

# Storage
DUCKDB_PATH=data/catalog.duckdb
ARTIFACT_ROOT=data/artifacts
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=evidence_units
MAX_SOURCE_UPLOAD_BYTES=5242880

# LLM and embeddings. Values here are placeholders only.
LLM_PROVIDER=litellm
LLM_MODEL=openai/gpt-5.5-mini
EMBEDDING_PROVIDER=litellm
EMBEDDING_MODEL=openai/text-embedding-3-large
LITELLM_API_BASE=
OPENAI_API_KEY=

# Security labels
DEFAULT_SOURCE_LABEL=internal
ALLOWED_SOURCE_LABELS=public,internal,confidential,restricted

# Frontend
VITE_API_BASE_URL=/api
